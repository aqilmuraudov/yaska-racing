class_name TextureLibrary
extends RefCounted
## Texture-quality asset tiers. Every scenery texture exists in three sizes
## (generated by tools/gen_textures.py):
##   tier 0 "low"    → res://assets/textures/low/<name>.png    (256 px base)
##   tier 1 "normal" → res://assets/textures/normal/<name>.png (512 px base)
##   tier 2 "high"   → res://assets/textures/high/<name>.png   (1024 px base)
## Materials register the parameter that samples a texture; changing the
## Texture Quality setting swaps them to the other tier in place, so open
## scenes update immediately and only one tier is kept in memory.

const TIERS := ["low", "normal", "high"]
const BASE := "res://assets/textures/"

static var tier := 1
static var _cache: Dictionary = {} # "tier/name" -> Texture2D
static var _bindings: Array = [] # [WeakRef(material), param, name]


static func path_for(tex_name: String, t: int) -> String:
	return BASE + TIERS[clampi(t, 0, 2)] + "/" + tex_name + ".png"


static func get_tex(tex_name: String) -> Texture2D:
	var key := "%d/%s" % [tier, tex_name]
	if _cache.has(key):
		return _cache[key]
	var p := path_for(tex_name, tier)
	var tex: Texture2D = null
	if ResourceLoader.exists(p):
		tex = load(p)
	else:
		# Fall back to any tier that exists (keeps the game running if a
		# generated set is incomplete).
		for t in [1, 0, 2]:
			if ResourceLoader.exists(path_for(tex_name, t)):
				tex = load(path_for(tex_name, t))
				break
	_cache[key] = tex
	return tex


## Sets `param` of a ShaderMaterial (or albedo of a StandardMaterial3D when
## param is "albedo_texture") and keeps it updated on tier changes.
static func bind(mat: Material, param: String, tex_name: String) -> void:
	_apply(mat, param, get_tex(tex_name))
	_bindings.append([weakref(mat), param, tex_name])


static func _apply(mat: Material, param: String, tex: Texture2D) -> void:
	if mat is ShaderMaterial:
		(mat as ShaderMaterial).set_shader_parameter(param, tex)
	elif mat is BaseMaterial3D:
		mat.set(param, tex)


static func set_tier(t: int) -> void:
	t = clampi(t, 0, 2)
	if t == tier:
		return
	tier = t
	_cache.clear() # drop the old tier; bound materials load the new one
	var alive: Array = []
	for b in _bindings:
		var mat: Material = (b[0] as WeakRef).get_ref()
		if mat == null:
			continue
		_apply(mat, b[1], get_tex(b[2]))
		alive.append(b)
	_bindings = alive


## Pixel width of a loaded texture (tests / debug overlay).
static func loaded_width(tex_name: String) -> int:
	var tex := get_tex(tex_name)
	return tex.get_width() if tex else 0
